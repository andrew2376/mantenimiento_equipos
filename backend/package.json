{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend para Sistema de Gestión y Trazabilidad de Mantenimiento de Equipos",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/src/main.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Antonia Gallego",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "prisma": "^6.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.0.7"
  }
}